@charset "utf-8";

@import url("https://fonts.googleapis.com/css?family=Roboto+Condensed:300,400,700");

body, html { margin: 0px; padding: 0px; height: 100%; font-family: "Roboto condensed"; }

body.admin-bar .navbar-fixed-top { position: fixed; top: 32px; z-index: 1000; }

a { color: rgb(99, 159, 211); }

a:focus, a:hover { color: rgb(42, 100, 150); text-decoration: none; }

.navbar { margin: 0px; border-width: medium medium 5px; border-style: none none solid; border-color: currentcolor currentcolor rgb(81, 147, 206); border-image: none; border-radius: 0px; background-color: rgb(255, 255, 255); background-image: none; text-transform: uppercase; }

.navbar h1 { margin: 0px; }

.navbar-inverse .navbar-brand { padding-bottom: 11px; color: rgb(40, 40, 38); font-weight: 300; font-size: 38px; }

.navbar-inverse .navbar-brand .arrow { margin-right: 5px; }

.navbar-nav ul { list-style-type: none; }

.navbar-inverse .navbar-nav > li > a { color: rgb(0, 0, 0); font-weight: 600; }

.navbar-inverse .navbar-nav > li > a:hover { color: rgb(81, 147, 206); font-weight: 600; }

.navbar-inverse .navbar-nav > .active > a, .navbar-inverse .navbar-nav > .active > a:hover, .navbar-inverse .navbar-nav > .active > a:focus { background-color: rgb(40, 40, 38); color: rgb(255, 255, 255); }

.navbar-sub { background: rgb(240, 237, 227); }

.navbar-sub .navbar-nav > li > a { color: rgb(102, 102, 102); }

.navbar-sub .navbar-nav > li > a:hover { background: rgb(220, 217, 208); color: rgb(0, 0, 0); }

#unsam-web a { color: rgb(0, 0, 0); font-size: 24px; }

#unsam-web a:hover { color: rgb(99, 159, 211); }

#unsam-web img { vertical-align: baseline; }

.featured { display: block; background: rgb(87, 60, 41); min-height: 50px; margin-top: 65px; }

.featured .item-featured { position: relative; overflow: hidden; padding: 0px; }

.featured img { z-index: 50; width: 100%; height: auto; transition: 0.3s ease-in-out; }

.featured .item-featured:hover > a img { opacity: 1; transform: scale(1.1); }

.yt-featured { width: 132.9% !important; margin-left: -15%; }

.featured .caption { position: absolute; bottom: 0px; z-index: 100; width: 100%; background: url("img/bg.png") repeat-x; color: rgb(255, 255, 255); }

.featured .cat { padding: 0px 20px; color: rgb(255, 255, 255); text-transform: uppercase; text-shadow: rgb(0, 0, 0) 0px 0px 3px; font-weight: 700; font-size: 12px; }

.featured .date { padding: 0px 20px; color: rgb(81, 147, 206); text-transform: uppercase; text-shadow: rgb(0, 0, 0) 0px 0px 3px; font-weight: 700; font-size: 12px; }

.featured .title { margin: 0px; padding: 5px 25px 25px; text-transform: uppercase; font-weight: 400; font-size: 27px; }

.spacer { height: 60px; }

.featured .cat { display: none; }

.featured .date { display: none; }

.cont-grid { float: right; padding: 10px 0px 0px 5px; border-left: 1px solid rgb(238, 238, 238); }

.cont-grid .post { padding: 20px 25px 20px 15px; }

.grid-cat { margin: 0px; color: rgb(51, 51, 51); text-transform: uppercase; font-weight: 700; font-size: 13px; }

.grid-tit { margin: 10px 0px; text-transform: uppercase; font-weight: 300; font-size: 28px; }

.grid-tit a { color: rgb(102, 102, 102); }

.grid-tit a:hover { color: rgb(0, 0, 0); text-decoration: none; }

.grid-cop { padding: 10px 0px 0px; }

.grid-text { padding: 15px 0px 0px; }

.grid .item { float: left; margin: 0px 5px 10px; width: 20%; height: auto; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221); background: rgb(255, 255, 255); }

.grid .item img { margin: 0px; width: 100%; height: auto; line-height: 0; }

.grid .item-w2 { width: 40%; }

